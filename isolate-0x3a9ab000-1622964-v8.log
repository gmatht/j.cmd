script-source,140,node:internal/fs/sync_write_stream,'use strict';\n\nconst {\n  FunctionPrototypeCall\x2C\n  ObjectSetPrototypeOf\x2C\n} = primordials;\nconst { kEmptyObject } = require('internal/util');\n\nconst { Writable } = require('stream');\nconst { closeSync\x2C writeSync } = require('fs');\n\nfunction SyncWriteStream(fd\x2C options) {\n  FunctionPrototypeCall(Writable\x2C this\x2C { autoDestroy: true });\n\n  options ||= kEmptyObject;\n\n  this.fd = fd;\n  this.readable = false;\n  this.autoClose = options.autoClose === undefined ? true : options.autoClose;\n}\n\nObjectSetPrototypeOf(SyncWriteStream.prototype\x2C Writable.prototype);\nObjectSetPrototypeOf(SyncWriteStream\x2C Writable);\n\nSyncWriteStream.prototype._write = function(chunk\x2C encoding\x2C cb) {\n  try {\n    writeSync(this.fd\x2C chunk\x2C 0\x2C chunk.length);\n  } catch (e) {\n    cb(e);\n    return;\n  }\n  cb();\n};\n\nSyncWriteStream.prototype._destroy = function(err\x2C cb) {\n  if (this.fd === null) // already destroy()ed\n    return cb(err);\n\n  if (this.autoClose)\n    closeSync(this.fd);\n\n  this.fd = null;\n  cb(err);\n};\n\nSyncWriteStream.prototype.destroySoon =\n  SyncWriteStream.prototype.destroy;\n\nmodule.exports = SyncWriteStream;\n
