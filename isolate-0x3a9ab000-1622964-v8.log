script-source,132,file:///root/src/sh2runtime/src/fs/webgldev.js,// \u2500\u2500\u2500 WebGLDevice: /dev/webgl \u2014 GPU via filesystem writes \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n//\n// Plan 9-style WebGL: every GPU resource is a file under /dev/webgl/.\n// Write shader source\x2C buffer data and uniform values as plain text\x2C\n// then drive drawing through /dev/webgl/call. The canvas is presented\n// to the screen when a "swap" call is written (hidden until then).\n//\n//   /dev/webgl/info                 read   GPU vendor/renderer/version\n//   /dev/webgl/extensions           read   supported extensions\n//   /dev/webgl/state                read   full device state\n//   /dev/webgl/log                  read   shader compile / link log\n//   /dev/webgl/shader/vertex        write  vertex shader source (compiles)\n//   /dev/webgl/shader/fragment      write  fragment shader source (compiles)\n//   /dev/webgl/program              write  "link" relinks \xb7 read status\n//   /dev/webgl/buffer/<name>        write  "f32 0 1 2 \u2026" | "u16 0 1 2 \u2026"\n//   /dev/webgl/bind                 write  "<attribute> <buffer> [size]"\n//   /dev/webgl/uniform/<t>/<name>   write  values (t: 1f 2f 3f 4f 1i m4)\n//   /dev/webgl/clearcolor           write  "r g b a"\n//   /dev/webgl/call                 write  "clear" | "swap" |\n//                                         "draw [arrays|elements] <mode> <count> <offset> [buffer]"\n//   /dev/webgl/depthmask            write  "0"/"1" \u2014 gl.depthMask (draw a\n//                                         background with writes off so\n//                                         later cubes always paint over it)\n//   /dev/webgl/frame                read   current frame as PNG data URL\n//\n// Shaders compile on write; the program links automatically at draw\n// time (or explicitly via /dev/webgl/program). Vertex attributes are\n// bound by name \u2014 a buffer whose name matches an active attribute\n// (case-insensitively) is bound to it\x2C or use /dev/webgl/bind to remap.\n// -----------------------------------------------------------------\n\nconst UNIFORM_TYPES = ["1f"\x2C "2f"\x2C "3f"\x2C "4f"\x2C "1i"\x2C "m4"];\nconst UNIFORM_ARITY = { "1f": 1\x2C "2f": 2\x2C "3f": 3\x2C "4f": 4\x2C "1i": 1\x2C m4: 16 };\nconst BUFFER_TYPES = ["f32"\x2C "f64"\x2C "u8"\x2C "u16"\x2C "i32"];\n\nconst BASE_ENTRIES = [\n  "bind"\x2C "buffer/"\x2C "call"\x2C "clearcolor"\x2C "extensions"\x2C "frame"\x2C\n  "info"\x2C "key"\x2C "log"\x2C "program"\x2C "shader/"\x2C "state"\x2C "uniform/"\x2C\n];\n\nfunction glTypeSize(gl\x2C type) {\n  switch (type) {\n    case gl.FLOAT:\n    case gl.INT: return 1;\n    case gl.FLOAT_VEC2:\n    case gl.INT_VEC2: return 2;\n    case gl.FLOAT_VEC3:\n    case gl.INT_VEC3: return 3;\n    case gl.FLOAT_VEC4:\n    case gl.INT_VEC4: return 4;\n    case gl.FLOAT_MAT2: return 2;\n    case gl.FLOAT_MAT3: return 3;\n    case gl.FLOAT_MAT4: return 4;\n    default: return 1;\n  }\n}\n\n// \u2500\u2500\u2500 NullGL: headless no-op device (CLI / tests\x2C no DOM) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Accepts every write and draw so /dev/webgl scripts (games like\n// mimecroft.sh) run logic-only in the Node CLI; the browser gets a real\n// WebGL context. Reads return plausible values; frame is a placeholder.\nfunction makeNullGL() {\n  const counters = { shaders: 0\x2C programs: 0\x2C buffers: 0\x2C draws: 0 };\n  const gl = {\n    VERTEX_SHADER: 0x8b31\x2C FRAGMENT_SHADER: 0x8b30\x2C\n    TEXTURE_2D: 0x0de1\x2C TEXTURE_MIN_FILTER: 0x2801\x2C TEXTURE_MAG_FILTER: 0x2800\x2C\n    TEXTURE_WRAP_S: 0x2802\x2C TEXTURE_WRAP_T: 0x2803\x2C CLAMP_TO_EDGE: 0x812f\x2C\n    NEAREST: 0x2600\x2C RGB: 0x1907\x2C RGBA: 0x1908\x2C UNPACK_ALIGNMENT: 0x0cf5\x2C\n    TEXTURE0: 0x84c0\x2C TEXTURE1: 0x84c1\x2C\n    ARRAY_BUFFER: 0x8892\x2C ELEMENT_ARRAY_BUFFER: 0x8893\x2C\n    STATIC_DRAW: 0x88e4\x2C COLOR_BUFFER_BIT: 0x4000\x2C DEPTH_BUFFER_BIT: 0x100\x2C DEPTH_TEST: 0x0b71\x2C LEQUAL: 0x0203\x2C LESS: 0x0201\x2C GEQUAL: 0x0206\x2C\n    TRIANGLES: 0x0004\x2C TRIANGLE_STRIP: 0x0005\x2C TRIANGLE_FAN: 0x0006\x2C\n    POINTS: 0x0000\x2C LINES: 0x0001\x2C LINE_LOOP: 0x0002\x2C LINE_STRIP: 0x0003\x2C\n    FLOAT: 0x1406\x2C INT: 0x1404\x2C FLOAT_VEC2: 0x8b50\x2C FLOAT_VEC3: 0x8b51\x2C\n    FLOAT_VEC4: 0x8b52\x2C INT_VEC2: 0x8b53\x2C INT_VEC3: 0x8b54\x2C INT_VEC4: 0x8b55\x2C\n    FLOAT_MAT2: 0x8b5a\x2C FLOAT_MAT3: 0x8b5b\x2C FLOAT_MAT4: 0x8b5c\x2C\n    UNSIGNED_BYTE: 0x1401\x2C UNSIGNED_SHORT: 0x1403\x2C\n    LINK_STATUS: 0x8b82\x2C\n    ACTIVE_ATTRIBUTES: 0x8b89\x2C ACTIVE_UNIFORMS: 0x8b86\x2C\n    COMPILE_STATUS: 0x8b81\x2C\n    createBuffer: () => ({ id: ++counters.buffers })\x2C\n    deleteBuffer: () => {}\x2C\n    bindBuffer: () => {}\x2C\n    bufferData: () => {}\x2C\n    createTexture: () => ({ id: ++counters.buffers })\x2C\n    deleteTexture: () => {}\x2C\n    bindTexture: () => {}\x2C\n    texParameteri: () => {}\x2C\n    pixelStorei: () => {}\x2C\n    texImage2D: () => {}\x2C\n    activeTexture: () => {}\x2C\n    createShader: () => ({ id: ++counters.shaders })\x2C\n    deleteShader: () => {}\x2C\n    shaderSource: () => {}\x2C\n    compileShader: () => {}\x2C\n    getShaderParameter: () => true\x2C\n    getShaderInfoLog: () => ""\x2C\n    createProgram: () => ({ id: ++counters.programs })\x2C\n    deleteProgram: () => {}\x2C\n    attachShader: () => {}\x2C\n    linkProgram: () => {}\x2C\n    getProgramParameter: (p\x2C name) => name === 0x8b82 ? 1 : (name === 0x8b89 ? 2 : (name === 0x8b86 ? 6 : 0))\x2C  // LINK/ATTRIBS/UNIFORMS for the null device\n    getProgramInfoLog: () => ""\x2C\n    useProgram: () => {}\x2C\n    getUniformLocation: () => ({})\x2C\n    uniform1f: () => {}\x2C uniform2f: () => {}\x2C uniform3f: () => {}\x2C\n    uniform4f: () => {}\x2C uniform1i: () => {}\x2C uniformMatrix4fv: () => {}\x2C\n    getAttribLocation: () => 0\x2C\n    enableVertexAttribArray: () => {}\x2C\n    vertexAttribPointer: () => {}\x2C\n    getActiveAttrib: (p\x2C i) => ({\n      name: i === 0 ? "aPosition" : "aShade"\x2C\n      type: gl.FLOAT_VEC3\x2C\n    })\x2C\n    drawArrays: () => { counters.draws++; }\x2C\n    drawElements: () => { counters.draws++; }\x2C\n    clear: () => {}\x2C\n    clearColor: () => {}\x2C\n    depthMask: () => {}\x2C\n    depthFunc: () => {}\x2C\n    flush: () => {}\x2C\n    getParameter: (p) => p === 0x1f02 ? "headless null device" : "0"\x2C\n    getSupportedExtensions: () => []\x2C\n  };\n  gl._counters = counters;\n  return gl;\n}\n\nexport class WebGLDevice {\n  constructor() {\n    this._gl = null;              // lazily created WebGL context\n    this._canvas = null;\n    this._contextName = null;\n    this._shaderSource = { vertex: ""\x2C fragment: "" };\n    this._shaders = { vertex: null\x2C fragment: null };  // compiled shaders\n    this._program = null;\n    this._programLinked = false;\n    this._log = "WebGL device ready.\\n";\n    this._buffers = new Map();    // name \u2192 { buffer\x2C arr\x2C type }\n    this._textures = new Map();   // texture index \u2192 WebGLTexture (R G B \u2026)\n    this._texSize = 0;            // texture dimension (square\x2C e.g. 16)\n    this._bindings = new Map();   // attribute \u2192 { buffer\x2C size }\n    this._uniforms = new Map();   // name \u2192 { type\x2C value: number[] }\n    this._clearColor = [0\x2C 0\x2C 0\x2C 1];\n    this._lastCall = "";\n    this._lastElementBuffer = null;  // name of last written u8/u16 buffer\n    this._keys = [];                 // key queue (a game reads /dev/webgl/key)\n    this._hudRects = null;           // overlay rect list (batched /dev/webgl/hud)\n    this._hudTris = null;           // overlay triangles (T \u2026 lines)\n    this._hudRectsR = null;         // overlay rotated rects (R \u2026 lines)\n    this._hudLayer = null;          // offscreen 2D layer \u2014 the transparent\n                                    // HUD texture\x2C persists across frames;\n                                    // composited onto the back buffer at swap\n    this._hudDirty = false;         // layer changed \u2192 re-upload texture at swap\n    this._hudTex = null;            // WebGL texture holding the layer\n    this._hudProg = null;           // built-in composite program (internal)\n    this._hudVerts = null;          // fullscreen textured-quad buffer\n    this._lastSwapAt = 0;            // for key-steal timeout after a game ends\n    this._keyListener = null;\n    this._null = false;              // headless null-device mode (no DOM)\n  }\n\n  // \u2500\u2500\u2500 Context \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n  _ensureGL() {\n    if (this._gl) return this._gl;\n    if (typeof document === "undefined") {\n      // Headless: a null device that accepts everything (no visuals).\n      this._gl = makeNullGL();\n      this._null = true;\n      this._contextName = "headless (null device)";\n      this._log += "[context] headless null device (no DOM)\\n";\n      return this._gl;\n    }\n    try {\n      const canvas = document.createElement("canvas");\n      canvas.width = 800;\n      canvas.height = 600;\n      canvas.id = "sh2runtime-webgl";\n      canvas.style.cssText = [\n        "position:fixed"\x2C "right:12px"\x2C "bottom:12px"\x2C "z-index:9999"\x2C\n        "border:1px solid #444"\x2C "border-radius:4px"\x2C "background:#000"\x2C\n        "display:none"\x2C "box-shadow:0 4px 20px rgba(0\x2C0\x2C0\x2C.5)"\x2C\n      ].join(";");\n      document.body.appendChild(canvas);\n      this._canvas = canvas;\n      // Prefer WebGL1: the target GLSL (attribute/varying/gl_FragColor)\n      // is ES 1.00\x2C which only compiles on a WebGL1 context.\n      // preserveDrawingBuffer:true keeps the presented back buffer \u2014\n      // with the default (false) the browser CLEARS the drawing buffer\n      // after every presentation\x2C so a game that renders only on\n      // actions (mimecroft.sh renders on keypresses\x2C idle between) goes\n      // BLACK once it stops rendering\x2C while the HUD (re-composited at\n      // each swap) stays visible.\n      const ctx = canvas.getContext("webgl"\x2C { preserveDrawingBuffer: true\x2C alpha: true }) ||\n                  canvas.getContext("webgl2"\x2C { preserveDrawingBuffer: true\x2C alpha: true }) ||\n                  canvas.getContext("experimental-webgl"\x2C { preserveDrawingBuffer: true\x2C alpha: true });\n      if (!ctx) throw new Error("context creation failed");\n      this._gl = ctx;\n      // Depth testing: the painter's-algorithm games (mimecroft.sh) draw\n      // cubes far-to-near\x2C but a cube right against the camera has its\n      // near face at z\u22480 (huge on screen) while its far face is small \u2014\n      // without per-pixel depth those faces overlap and the block\n      // flickers between "zoomed in" and "zoomed out". Enable depth so\n      // the GPU sorts every fragment correctly.\n      try { ctx.enable(ctx.DEPTH_TEST); ctx.depthFunc(ctx.LEQUAL); } catch {}\n      this._contextName = (typeof WebGL2RenderingContext !== "undefined" &&\n                           ctx instanceof WebGL2RenderingContext)\n        ? "WebGL2" : "WebGL1";\n      this._log += `[context] ${this._contextName} ready\\n`;\n      // A game (e.g. mimecroft.sh) steals the keyboard while the canvas\n      // is presenting: capture keys into a queue readable at\n      // /dev/webgl/key. Keys flow back to the shell ~2s after the last\n      // swap\x2C so an abandoned game can't lock the terminal.\n      if (!this._keyListener) {\n        this._keyListener = (e) => {\n          const visible = this._canvas && this._canvas.style.display !== "none";\n          const fresh = Date.now() - this._lastSwapAt < 2000;\n          if (!visible || !fresh)