script-source,87,file:///root/src/sh2runtime/__dbg-hb-run.mjs,import { readFileSync } from "fs";\nimport { fs } from "/root/src/sh2runtime/src/fs/index.js";\nimport { createSh2Runtime } from "/root/src/sh2runtime/src/sh2runtime.js";\nconst file = process.argv[2] || "/tmp/cur.js";\nconst js = readFileSync(file\x2C "utf8");\nconst KEYS = ["q\x2C"];\nlet keyFrame = 0\x2C sleepCount = 0;\nconst stdout = [];\nconst shellExec = async (cmdline) => {\n  const cl = cmdline.trim(); const cmd = cl.split(/\\s+/)[0];\n  let rest = cl.slice(cmd.length).trim();\n  if (rest.startsWith("'") && rest.endsWith("'")) rest = rest.slice(1\x2C -1);\n  let out = "";\n  if (cmd === "echo") out = rest + "\\n";\n  else if (cmd === "cat") {\n    const p = fs._resolve(rest.split(/\\s+/)[0]);\n    if (p === "/dev/webgl/key") { out = (keyFrame < KEYS.length ? KEYS[keyFrame] : "q\x2C") + "\\n"; keyFrame++; }\n    else { try { out = await fs.read(p); } catch { out = ""; } }\n  }\n  else if (cmd === "sleep") { sleepCount++; if (sleepCount > 2500) throw new Error("stop"); await new Promise(r => setTimeout(r\x2C 0)); }\n  else if (cmd === "sh2glsl") { out = ""; }\n  else if (cmd === "true") {}\n  else out = `${cmd}: command not found\\n`;\n  return { out\x2C err: ""\x2C code: 0 };\n};\nconst out = { write: (s) => stdout.push(s) };\nconst rt = createSh2Runtime({ fs\x2C env: { HOME: "/home" }\x2C shellExec\x2C stdout: out\x2C stderr: { write: (s) => stdout.push("[err] " + s) }\x2C args: []\x2C argv0: "bash" });\nconst hb = setInterval(() => console.error("HB")\x2C 3000);\nconst fn = new Function("args"\x2C "fs"\x2C "env"\x2C "stdout"\x2C "stderr"\x2C "__runCmd"\x2C "sh2"\x2C "return (async () => { " + js + " })();");\ntry { await fn([]\x2C fs\x2C { HOME: "/home" }\x2C out\x2C { write: (s) => stdout.push("[err] " + s) }\x2C shellExec\x2C rt.sh2); }\ncatch (e) { if (e.message !== "stop") { console.log("RUN ERROR:"\x2C e.message); process.exit(1); } }\nconsole.log("completed");\n
