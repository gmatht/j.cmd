 type: "dir"\x2C size: 0\x2C mtime: undefined };\n        } else {\n          throw e;\n        }\n      }\n    }\n    const a = this._attrFor(r);\n    return { ...st\x2C owner: a.owner\x2C mode: a.mode };\n  }\n\n  // Synchronous stat\x2C or null when the backend can't do it synchronously\n  // (remote mounts\x2C missing file). sh2.test's file tests rely on this.\n  statSync(path) {\n    try {\n      const r = this._resolve(path);\n      if (!this._can(this._parent(r)\x2C "x")) return null;\n      const m = this._findBackend(r);\n      if (!m || !m.backend.statSync) return null;\n      const st = m.backend.statSync(m.relative);\n      const a = this._attrFor(r);\n      return { ...st\x2C owner: a.owner\x2C mode: a.mode };\n    } catch {\n      return null;\n    }\n  }\n\n\n  // Synchronous read/write/list for LOCAL mounts \u2014 the emscripten\n  // custom-FS bridge (bash.wasm's libc file calls are sync) uses these;\n  // remote mounts (HttpFS/GitHubFS/\u2026) have no sync path \u2192 null/false.\n  readSync(path) {\n    try {\n      const r = this._resolve(path);\n      const m = this._findBackend(r);\n      if (!m || !m.backend.readSync) return null;\n      return m.backend.readSync(m.relative);\n    } catch {\n      return null;\n    }\n  }\n  writeSync(path\x2C content) {\n    try {\n      const r = this._resolve(path);\n      const m = this._findBackend(r);\n      if (!m || !m.backend.writeSync) return false;\n      m.backend.writeSync(m.relative\x2C content);\n      return true;\n    } catch {\n      return false;\n    }\n  }\n  listSync(path) {\n    try {\n      const r = this._resolve(path);\n      const m = this._findBackend(r);\n      if (!m || !m.backend.listSync) return null;\n      return m.backend.listSync(m.relative);\n    } catch {\n      return null;\n    }\n  }\n\n  // \u2500\u2500\u2500 formatList: human-readable directory listing \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n  async formatList(path\x2C opts = {}) {\n    const entries = await this.list(path);\n    if (entries.length === 0) return "";\n    if (opts.long) return await this.formatLongList(path\x2C entries);\n\n    // Classify entries for coloring: dirs \u2192 blue\x2C executable files\n    // (.js/.mjs/.wasm \u2014 the formats this shell runs) \u2192 green\x2C other\n    // files \u2192 white. Every backend marks directories with a trailing\n    // slash\x2C so dirs need no stat \u2014 and on GitHub a stat is an API call\n    // per entry\x2C so short listings must not burn quota on them. stat is\n    // best-effort for files: remote/virtual backends may not support it\n    // (stat returns null)\x2C so fall back to the trailing-slash\n    // convention.\n    const kinds = [];\n    for (const e of entries) {\n      let kind = "file";\n      if (e.endsWith("/")) {\n        kind = "dir";\n      } else if (this._isLink(path + "/" + e)) {\n        // Classify symlinks without a stat: a stat would follow the\n        // link\x2C and for /http/ or /github targets that means fetching\n        // the target just to colorize a name.\n        kind = "link";\n      } else {\n        try {\n          const st = await this.stat(path + "/" + e);\n          if (st && st.type === "dir") kind = "dir";\n          else if (st && st.type === "file" && isExecutableName(e)) kind = "exe";\n          else if (!st) kind = "file";\n        } catch {\n          kind = "file";\n        }\n      }\n      kinds.push(kind);\n    }\n\n    // Column count adapts to the terminal width when the caller passes\n    // one (the browser shell does); otherwise default to 4 columns.\n    const widths = entries.map(e => e.length);\n    const colW = Math.max(...widths) + 2;\n    const cols = opts.width\n      ? Math.max(1\x2C Math.floor(opts.width / colW))\n      : Math.max(1\x2C opts.cols || 4);\n    const rows = [];\n    for (let i = 0; i < entries.length; i += cols) {\n      rows.push(\n        entries.slice(i\x2C i + cols)\n          .map((e\x2C j) => {\n            const name = colorize(e\x2C kinds[i + j]);\n            // Pad on the *visible* length so ANSI codes don't misalign columns\n            return j === cols - 1 ? name : name + " ".repeat(Math.max(0\x2C colW - e.length));\n          })\n          .join("")\n      );\n    }\n    return rows.join("\\n") + "\\n";\n  }\n\n  // Long format: permissions\x2C nlink\x2C owner\x2C group\x2C size\x2C date\x2C name\n  async formatLongList(path\x2C entries) {\n    const rows = [];\n    for (const entry of entries) {\n      const isDir = entry.endsWith("/");\n      const name = isDir ? entry.slice(0\x2C -1) : entry;\n      const full = path + "/" + entry;\n      // Symlinks render as lrwxrwxrwx with a "-> target" suffix \u2014 no\n      // stat of the target (that could mean fetching a 60 MB video).\n      const linkTarget = isDir ? null : this._readlinkTarget(full);\n      if (linkTarget !== null) {\n        const a = this._attrFor(full);\n        rows.push({\n          mode: "lrwxrwxrwx"\x2C\n          owner: a.owner\x2C\n          size: linkTarget.length\x2C\n          date: "-"\x2C\n          name: colorize(name\x2C "link") + " -> " + linkTarget\x2C\n        });\n        continue;\n      }\n      let st = null;\n      try {\n        st = await this.stat(full);\n      } catch {\n        st = null;  // remote/virtual backends without metadata\n      }\n      const type = isDir ? "dir" : (st && st.type) || "file";\n      const size = st && st.size !== undefined ? st.size : (isDir ? 0 : "-");\n      const mtime = st && st.mtime;\n      const exe = type === "file" && isExecutableName(name);\n      const a = this._attrFor(path + "/" + entry);\n      rows.push({\n        mode: modeToString(type === "dir" ? "dir" : "file"\x2C a.mode)\x2C\n        owner: a.owner\x2C\n        size\x2C\n        date: formatMtime(mtime)\x2C\n        name: colorize(name\x2C type === "dir" ? "dir" : exe ? "exe" : "file")\x2C\n      });\n    }\n    const sizeW = Math.max(...rows.map(r => String(r.size).length));\n    const dateW = Math.max(...rows.map(r => r.date.length));\n    return rows.map(r =>\n      `${r.mode} 1 ${r.owner} ${r.owner} ${String(r.size).padStart(sizeW)} ${r.date.padEnd(dateW)} ${r.name}`\n    ).join("\\n") + "\\n";\n  }\n\n  // Long listing for a single FILE path (`ls -l /path/to/file`). Real\n  // ls prints the file's own entry; formatList can't \u2014 listing a file\n  // path is ENOTDIR. Rendered with the same columns as formatLongList.\n  async formatLongFile(path) {\n    const name = path.split("/").filter(Boolean).pop() || "/";\n    // A symlink path renders as the link itself (lrwxrwxrwx -> target)\x2C\n    // like GNU ls -l without a trailing slash.\n    const linkTarget = this._readlinkTarget(path);\n    if (linkTarget !== null) {\n      const a = this._attrFor(path);\n      return `lrwxrwxrwx 1 ${a.owner} ${a.owner} ${String(linkTarget.length)} - ${colorize(name\x2C "link")} -> ${linkTarget}\\n`;\n    }\n    const st = await this.stat(path);\n    const type = st && st.type === "dir" ? "dir" : "file";\n    const size = st && st.size !== undefined ? st.size : "-";\n    const a = this._attrFor(path);\n    const exe = type === "file" && isExecutableName(name);\n    return `${modeToString(type\x2C a.mode)} 1 ${a.owner} ${a.owner} ${String(size).padStart(String(size).length)} ${formatMtime(st && st.mtime)} ${colorize(name\x2C type === "dir" ? "dir" : exe ? "exe" : "file")}\\n`;\n  }\n}\n\n// \u2500\u2500\u2500 ls colors \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// ANSI SGR codes: directories blue\x2C executable files green\x2C plain\n// files white (the terminal renders the escapes; browsers map them\n// to their palette in www/index.html).\nconst ANSI = {\n  blue: "\\x1b[34m"\x2C\n  green: "\\x1b[32m"\x2C\n  magenta: "\\x1b[35m"\x2C\n  white: "\\x1b[37m"\x2C\n  reset: "\\x1b[0m"\x2C\n};\n\n// An entry is "executable" if the shell can run it directly: .js/.mjs\n// command scripts or .wasm binaries (the virtual machine's native\n// binary format).\nfunction isExecutableName(name) {\n  return /\\.(js|mjs|wasm)$/i.test(name);\n}\n\n// Wrap a name in its color code. Callers pad using the raw (visible)\n// length so the invisible escapes never shift the columns.\nfunction colorize(name\x2C kind) {\n  const code = kind === "dir" ? ANSI.blue\n    : kind === "exe" ? ANSI.green\n    : kind === "link" ? ANSI.magenta\n    : ANSI.white;\n  return `${code}${name}${ANSI.reset}`;\n}\n\n// Unix-style date column: "Mon DD HH:MM" for this year\x2C else "Mon DD  YYYY"\n// rwx string for a mode\x2C no group concept (group bits displayed as other).\nfunction modeToString(type\x2C mode) {\n  const seg = (r\x2C w\x2C x) =>\n    ((mode & r) ? "r" : "-") + ((mode & w) ? "w" : "-") + ((mode & x) ? "x" : "-");\n  const owner = seg(0o400\x2C 0o200\x2C 0o100);\n  const other = seg(0o004\x2C 0o002\x2C 0o001);\n  // group bits shown as other (no group concept in the VFS)\n  return (type === "dir" ? "d" : "-") + owner + other + other;\n}\n\nfunction formatMtime(ms) {\n  if (!ms) return "-";\n  const d = new Date(ms);\n  const months = ["Jan"\x2C"Feb"\x2C"Mar"\x2C"Apr"\x2C"May"\x2C"Jun"\x2C\n                  "Jul"\x2C"Aug"\x2C"Sep"\x2C"Oct"\x2C"Nov"\x2C"Dec"];\n  const mon = months[d.getMonth()];\n  const day = String(d.getDate()).padStart(2);\n  if (d.getFullYear() === new Date().getFullYear()) {\n    const hh = String(d.getHours()).padStart(2\x2C "0");\n    const mm = String(d.getMinutes()).padStart(2\x2C "0");\n    return `${mon} ${day} ${hh}:${mm}`;\n  }\n  return `${mon} ${day}  ${d.getFullYear()}`;\n}\n\n// Singleton\nexport const fs = new VirtualFS();\n
