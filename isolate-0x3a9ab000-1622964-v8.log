script-source,135,file:///root/src/sh2runtime/src/fs/downloadfs.js,// \u2500\u2500\u2500 DownloadFS: /pc/ \u2014 bridge between virtual FS and real machine \u2500\n//\n// Write to /pc/<name> \u2192 triggers a browser download of that file\n// to the user's Downloads folder (filename already known\x2C so just\n// download like normal).\n// Read from /pc/ \u2192 opens a file picker to select a local file.\n//\n// Examples:\n//   cp report.csv /pc            \u2192 downloads report.csv\n//   echo hello > /pc/note.txt    \u2192 downloads note.txt\n//   cp /pc/photo.jpg .           \u2192 file picker \u2192 import into virtual FS\n// -----------------------------------------------------------------\n\n// Extension \u2192 MIME type hints for the open-file picker\nconst MIME_HINTS = {\n  ".png": "image/png"\x2C ".jpg": "image/jpeg"\x2C ".jpeg": "image/jpeg"\x2C\n  ".gif": "image/gif"\x2C ".svg": "image/svg+xml"\x2C ".webp": "image/webp"\x2C\n  ".bmp": "image/bmp"\x2C ".ico": "image/x-icon"\x2C\n  ".txt": "text/plain"\x2C ".md": "text/markdown"\x2C ".log": "text/plain"\x2C\n  ".json": "application/json"\x2C ".js": "text/javascript"\x2C\n  ".wasm": "application/wasm"\x2C ".pdf": "application/pdf"\x2C\n  ".mp3": "audio/mpeg"\x2C ".wav": "audio/wav"\x2C ".ogg": "audio/ogg"\x2C\n  ".mp4": "video/mp4"\x2C ".zip": "application/zip"\x2C\n  ".sh": "text/x-sh"\x2C ".rs": "text/x-rust"\x2C ".c": "text/x-c"\x2C\n  ".html": "text/html"\x2C ".css": "text/css"\x2C ".py": "text/x-python"\x2C\n};\n\nfunction mimeHint(path) {\n  const lower = path.toLowerCase();\n  for (const [ext\x2C mime] of Object.entries(MIME_HINTS)) {\n    if (lower.endsWith(ext)) return mime;\n  }\n  return null;\n}\n\nexport class DownloadFS {\n  async read(path) {\n    const file = await this._pickFile(path);\n    return await file.text();\n  }\n\n  async readBlob(path) {\n    // Return the File directly \u2014 File extends Blob and preserves bytes\n    return await this._pickFile(path);\n  }\n\n  async _pickFile(path) {\n    const name = path.replace(/^\\//\x2C "");\n    const mime = mimeHint(name);\n\n    // Prefer the File System Access API (Chromium)\n    if (window.showOpenFilePicker) {\n      const options = {};\n      if (mime) {\n        options.types = [{ description: name\x2C accept: { [mime]: [name.split(".").pop()] } }];\n        options.excludeAcceptAllOption = true;\n      }\n      try {\n        const [handle] = await window.showOpenFilePicker(options);\n        return await handle.getFile();\n      } catch (e) {\n        throw new Error(`file picker cancelled: ${e.message}`);\n      }\n    }\n\n    // Fallback (Firefox/Safari): hidden <input type=file>\n    return await this._pickViaInput(mime);\n  }\n\n  _pickViaInput(mime) {\n    return new Promise((resolve\x2C reject) => {\n      const input = document.createElement("input");\n      input.type = "file";\n      if (mime) input.accept = mime;\n      input.style.display = "none";\n      document.body.appendChild(input);\n      input.onchange = () => {\n        const file = input.files && input.files[0];\n        document.body.removeChild(input);\n        if (file) resolve(file);\n        else reject(new Error("no file selected"));\n      };\n      // User pressed Escape / cancelled\n      input.addEventListener("cancel"\x2C () => {\n        document.body.removeChild(input);\n        reject(new Error("file picker cancelled"));\n      });\n      input.click();\n    });\n  }\n\n  async write(path\x2C content) {\n    const name = path.replace(/^\\//\x2C "");\n    if (!name) {\n      throw new Error("EROFS: specify a filename (/pc/name)");\n    }\n    const blob = typeof content === "string"\n      ? new Blob([content]\x2C { type: mimeHint(name) || "text/plain" })\n      : new Blob([content]);\n    this._download(name\x2C blob);\n  }\n\n  async writeBlob(path\x2C blob) {\n    const name = path.replace(/^\\//\x2C "");\n    if (!name) {\n      throw new Error("EROFS: specify a filename (/pc/name)");\n    }\n    this._download(name\x2C blob);\n  }\n\n  // \u2500\u2500\u2500 writeStream: STREAM a download instead of materializing it \u2500\u2500\u2500\n  // With StreamSaver (vendored: streamsaver.js + mitm.html + sw.js) the\n  // data is piped through a service worker to a real incremental disk\n  // write\x2C so huge artifacts (tar -czf /pc/backup.tgz /) never sit in\n  // memory. Without a service worker (or in the CLI) it falls back to\n  // buffering the chunks and downloading one Blob at close.\n  // Returns a WHATWG WritableStream; write Uint8Array chunks\x2C close()\n  // finishes the download.\n  async writeStream(path\x2C { size } = {}) {\n    const name = path.replace(/^\\//\x2C "");\n    if (!name) throw new Error("EROFS: specify a filename (/pc/name)");\n    const mime = mimeHint(name) || "application/octet-stream";\n\n    if (typeof window !== "undefined" && typeof document !== "undefined") {\n      try {\n        await this._ensureStreamSaver();\n        const opts = {};\n        if (size) opts.size = size;\n        return window.streamSaver.createWriteStream(name\x2C opts);\n      } catch {\n        // StreamSaver unavailable (SW blocked / offline) \u2014 buffer instead\n      }\n    }\n\n    // Buffered fallback: collect chunks\x2C download one Blob on close.\n    const chunks = [];\n    const enc = new TextEncoder();\n    const download = () => this._download(name\x2C new Blob(chunks\x2C { type: mime }));\n    return new WritableStream({\n      write(chunk) {\n        chunks.push(chunk instanceof Uint8Array ? chunk : enc.encode(String(chunk)));\n      }\x2C\n      close() { download(); chunks.length = 0; }\x2C\n      abort() { chunks.length = 0; }\x2C\n    });\n  }\n\n  // Load the vendored StreamSaver lib and point it at our mitm page.\n  async _ensureStreamSaver() {\n    if (window.streamSaver && window.streamSaver.createWriteStream) {\n      window.streamSaver.mitm = "vendor/mitm.html";\n      return;\n    }\n    await new Promise((resolve\x2C reject) => {\n      const src = "vendor/streamsaver.js";\n      if (document.querySelector('script[src="' + src + '"]')) return resolve();\n      const s = document.createElement("script");\n      s.src = src;\n      s.onload = () => { window.streamSaver.mitm = "vendor/mitm.html"; resolve(); };\n      s.onerror = () => reject(new Error("failed to load " + src));\n      document.head.appendChild(s);\n    });\n  }\n\n  _download(name\x2C blob) {\n    // Filename is already known \u2014 just download like a normal browser\n    // download to the Downloads folder. No save dialog needed.\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement("a");\n    a.href = url;\n    a.download = name;\n    a.rel = "noopener";\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    setTimeout(() => URL.revokeObjectURL(url)\x2C 1000);\n  }\n\n  async list(path) {\n    return [];\n  }\n\n  async stat(path) {\n    // Never fall back to read() \u2014 read() opens the file picker! /pc is\n    // a virtual bridge to the real machine: the mount root is a dir\x2C\n    // and any /pc/<name> only exists once you pick a file for it.\n    const p = path.replace(/^\\/+|\\/+$/g\x2C "") || "/";\n    if (p === "/") return { type: "dir"\x2C size: 0\x2C mtime: undefined };\n    return { type: "file"\x2C size: 0\x2C mtime: undefined };\n  }\n\n  async remove(path) {\n    throw new Error("EROFS: cannot remove from /pc/");\n  }\n}\n
