script-source,129,file:///root/src/sh2runtime/src/fs/gitfs.js,import { ensurePako } from "../pako.js";\n\n// \u2500\u2500\u2500 GitFS: mount a git repo as a filesystem (read tree\x2C read blobs) \u2500\u2500\n//\n// Real git\x2C no API dependency. This backend speaks the git wire protocol\n// directly over HTTP\x2C so ANY git repository can be mounted as a directory\n// tree \u2014 GitHub\x2C GitLab\x2C Gitea\x2C cgit\x2C or a bare repo served by a plain\n// static file server.\n//\n// Path format:\n//   /mount/git/                                         \u2014 featured repos + README\n//   /mount/git/{host}/{repo-path}/{file-path}           \u2014 browse a repo\n//   /mount/git/github.com/gmatht/sh2perl/               \u2014 list repo root\n//   /mount/git/github.com/gmatht/sh2perl/README.md      \u2014 read a blob\n//   /mount/git/gitlab.com/group/subgroup/repo/src/main.rs  \u2014 gitlab subgroups\n//   /mount/git/localhost:8000/myrepo.git/               \u2014 dumb HTTP (static serve)\n//\n// How it works:\n//   - Smart HTTP (git-upload-pack): the standard git protocol. Objects are\n//     fetched lazily \u2014 one small request per commit/tree/blob \u2014 so `ls`\n//     downloads only the trees it needs and `cat` only the blob it needs.\n//     A directory listing never downloads file contents.\n//   - Dumb HTTP (loose objects + packfiles): plain GETs. Works against any\n//     static file server that is serving a (bare) git repo\x2C which is handy\n//     for local testing and LAN mounts.\n//   - Objects are parsed at the wire level: commits\x2C trees\x2C blobs\x2C and\n//     packfiles including ofs-delta / ref-delta compression.\n//\n// In the browser\x2C git hosts don't send CORS headers\x2C so a CORS proxy is\n// required there:  new GitFS({ proxy: "https://cors.example/" })  \u2014 the\n// proxy is prefixed to every request URL. The Node CLI works directly.\n// -----------------------------------------------------------------\n\nconst FEATURED = [\n  { host: "github.com"\x2C path: "gmatht/sh2perl"\x2C desc: "the sh2perl transpiler" }\x2C\n  { host: "github.com"\x2C path: "gmatht/debashc"\x2C desc: "shell script converter" }\x2C\n  { host: "github.com"\x2C path: "torvalds/linux"\x2C desc: "Linux kernel source" }\x2C\n  { host: "github.com"\x2C path: "rust-lang/rust"\x2C desc: "Rust compiler" }\x2C\n  { host: "github.com"\x2C path: "python/cpython"\x2C desc: "Python interpreter" }\x2C\n  { host: "github.com"\x2C path: "nodejs/node"\x2C desc: "Node.js runtime" }\x2C\n  { host: "github.com"\x2C path: "git/git"\x2C desc: "Git version control" }\x2C\n  { host: "gitlab.com"\x2C path: "gitlab-org/gitlab-foss"\x2C desc: "GitLab Community Edition" }\x2C\n];\n\nconst TYPE_NAME = { 1: "commit"\x2C 2: "tree"\x2C 3: "blob"\x2C 4: "tag" };\nconst enc = new TextEncoder();\nconst dec = new TextDecoder();\n\nfunction hex(buf) {\n  let s = "";\n  for (let i = 0; i < buf.length; i++) s += buf[i].toString(16).padStart(2\x2C "0");\n  return s;\n}\n\nfunction concatBytes(arrays) {\n  const total = arrays.reduce((n\x2C a) => n + a.length\x2C 0);\n  const out = new Uint8Array(total);\n  let o = 0;\n  for (const a of arrays) { out.set(a\x2C o); o += a.length; }\n  return out;\n}\n\n// SHA-1 over raw object bytes (header + "\\0" + content). Browsers and\n// modern Node both expose crypto.subtle; fall back to node:crypto.\nasync function sha1Hex(bytes) {\n  if (globalThis.crypto && globalThis.crypto.subtle) {\n    return hex(new Uint8Array(await globalThis.crypto.subtle.digest("SHA-1"\x2C bytes)));\n  }\n  const { createHash } = await import("node:crypto");\n  return createHash("sha1").update(bytes).digest("hex");\n}\n\n// zlib inflate. git packs and loose objects are zlib streams.\n//   node:    node:zlib (strict: throws on truncation\x2C ignores trailing)\n//   browser: global pako via script tag (lenient: may skip the adler32\n//            trailer\x2C so pack probing verifies the adler itself)\nlet _zlib = null;\nlet _usesPako = false;\nfunction detectInflate() {\n  if (_zlib !== null) return;\n  if (typeof process !== "undefined" && process.versions && process.versions.node) {\n    _zlib = { kind: "zlib" };  // resolved lazily below\n  } else {\n    _zlib = { kind: "pako" };\n  }\n  _usesPako = _zlib.kind === "pako";\n}\n\nasync function inflate(buf) {\n  detectInflate();\n  if (_zlib.kind === "zlib") {\n    if (!_zlib.mod) _zlib.mod = await import("node:zlib");\n    return new Uint8Array(_zlib.mod.inflateSync(Buffer.from(buf)));\n  }\n  await ensurePako();  // lazy-load vendor/pako.min.js in the browser\n  if (globalThis.pako) return new Uint8Array(globalThis.pako.inflate(buf));\n  throw new Error("GitFS: pako is not loaded \u2014 add the pako script tag before the shell module");\n}\n\n// \u2500\u2500\u2500 pkt-line framing (git wire protocol) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction pktLine(str) {\n  const b = enc.encode(str);\n  return concatBytes([enc.encode((b.length + 4).toString(16).padStart(4\x2C "0"))\x2C b]);\n}\n\nfunction decodePktLines(buf) {\n  const out = [];\n  let i = 0;\n  while (i + 4 <= buf.length) {\n    const len = parseInt(dec.decode(buf.subarray(i\x2C i + 4))\x2C 16);\n    if (len === 0) { out.push({ flush: true }); i += 4; continue; }\n    if (len === 1) { out.push({ delim: true }); i += 4; continue; }\n    if (len === 2) { out.push({ end: true }); i += 4; continue; }\n    out.push({ data: buf.subarray(i + 4\x2C i + len) });\n    i += len;\n  }\n  return out;\n}\n\n// Build the body of a git-upload-pack request (protocol v0):\n//   want <sha> <caps>\n//   [filter <spec>]\n//   (flush)\n//   done\n//   (flush)\nfunction uploadPackRequest(wants\x2C { filter\x2C caps } = {}) {\n  const lines = [];\n  const capList = ["multi_ack_detailed"\x2C "side-band-64k"\x2C "ofs-delta"];\n  if (filter) capList.push("filter");\n  for (const cap of caps || []) {\n    if (!capList.includes(cap) && cap !== "agent") capList.push(cap);\n  }\n  capList.push("agent=sh2runtime/0.1");\n  lines.push(pktLine(`want ${wants[0]} ${capList.join(" ")}\\n`));\n  for (const w of wants.slice(1)) lines.push(pktLine(`want ${w}\\n`));\n  if (filter) lines.push(pktLine(`filter ${filter}\\n`));\n  lines.push(enc.encode("0000"));        // flush pkt-line\n  lines.push(pktLine("done\\n"));\n  lines.push(enc.encode("0000"));        // flush pkt-line\n  return concatBytes(lines);\n}\n\n// Parse a git-upload-pack response (side-band-64k) and return the raw\n// packfile bytes. Channel 1 = pack data\x2C 2 = progress\x2C 3 = error.\nfunction extractPack(buf) {\n  const chunks = [];\n  let i = 0;\n  while (i + 4 <= buf.length) {\n    const len = parseInt(dec.decode(buf.subarray(i\x2C i + 4))\x2C 16);\n    if (len === 0 || len === 1 || len === 2) { i += 4; continue; }\n    const payload = buf.subarray(i + 4\x2C i + len);\n    i += len;\n    const head = dec.decode(payload.subarray(0\x2C Math.min(4\x2C payload.length)));\n    if (head === "NAK\\n" || head.startsWith("ACK")) continue;  // negotiation result\n    if (head === "ERR ") throw new Error("git-upload-pack: " + dec.decode(payload.subarray(4)));\n    const ch = payload[0];\n    if (ch === 1) chunks.push(payload.subarray(1));          // pack data\n    else if (ch === 3) throw new Error("git-upload-pack: " + dec.decode(payload.subarray(1)));\n    // ch === 2 \u2192 progress\x2C ignore\n  }\n  const pack = concatBytes(chunks);\n  if (dec.decode(pack.subarray(0\x2C 4)) !== "PACK") {\n    throw new Error("git-upload-pack: not a packfile response");\n  }\n  return pack;\n}\n\n// \u2500\u2500\u2500 Object parsing \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function parseLooseObject(buf) {\n  const data = await inflate(buf);\n  const nul = data.indexOf(0);\n  const header = dec.decode(data.subarray(0\x2C nul));\n  const [type\x2C sizeStr] = header.split(" ");\n  const size = parseInt(sizeStr\x2C 10);\n  const body = data.subarray(nul + 1);\n  if (body.length !== size) throw new Error("loose object size mismatch");\n  return { type\x2C data: body };\n}\n\n// Tree object: "<mode> <name>\\0<20-byte sha>" entries\nfunction parseTree(data) {\n  const entries = [];\n  let i = 0;\n  while (i < data.length) {\n    let j = i;\n    while (data[j] !== 0x20) j++;\n    const mode = parseInt(dec.decode(data.subarray(i\x2C j))\x2C 8);\n    i = j + 1;\n    j = i;\n    while (data[j] !== 0x00) j++;\n    const name = dec.decode(data.subarray(i\x2C j));\n    i = j + 1;\n    entries.push({ mode\x2C name\x2C sha: hex(data.subarray(i\x2C i + 20)) });\n    i += 20;\n  }\n  return entries;\n}\n\n// Commit object: "tree <sha>\\n[parent <sha>\\n]* author ... committer ..."\nfunction parseCommit(data) {\n  const text = dec.decode(data);\n  const tree = /^tree ([0-9a-f]{40})\\n/.exec(text);\n  const committer = /\\ncommitter .*? <.*?> (\\d+)/.exec(text);\n  return {\n    tree: tree && tree[1]\x2C\n    committerDate: committer ? parseInt(committer[1]\x2C 10) * 1000 : undefined\x2C\n  };\n}\n\n// \u2500\u2500\u2500 Delta encoding (ofs-delta / ref-delta) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// git's little-endian 7-bit varint (delta base/result sizes)\nfunction readLEB128(buf\x2C st) {\n  let result = 0\x2C shift = 0\x2C b;\n  do {\n    b = buf[st.i++];\n    result |= (b & 0x7f) << shift;\n    shift += 7;\n  } while (b & 0x80);\n  return result;\n}\n\nfunction applyDelta(base\x2C delta) {\n  const st = { i: 0 };\n  readLEB128(delta\x2C st);              // base size\n  const resultSize = readLEB128(delta\x2C st);\n  const out = new Uint8Array(resultSize);\n  let o = 0;\n  while (st.i < delta.length) {\n    const op = delta[st.i++];\n    if (op & 0x80) {\n      // copy from base: offset/size encoded in the opcode's bit flags\n      let ofs = 0\x2C size = 0;\n      if (op & 0x01) ofs |= delta[st.i++];\n      if (op & 0x02) ofs |= delta[st.i++] << 8;\n      if (op & 0x04) ofs |= delta[st.i++] << 16;\n      if (op & 0x08) ofs |= delta[st.i++] << 24;\n      if (op & 0x10) size |= delta[st.i++];\n      if (op & 0x20) size |= delta[st.i++] << 8;\n      if (op & 0x40) size |= delta[st.i++] << 16;\n      // bit 7 is the copy marker itself \u2014 git sizes max out at 3 bytes\n      if (size === 0) size = 0x10000;\n      out.set(base.subarray(ofs\x2C ofs + size)\x2C o);\n      o += size;\n    } else if (op > 0) {\n      // literal insert\n      out.set(delta.subarray(st.i\x2C st.i + op)\x2C o);\n      st.i += op;\n      o += op;\n    }\n  }\n  if (o !== resultSize) throw new Error("pack: delta size mismatch");\n  return out;\n}\n\n// \u2500\u2500\u2500 Packfile parsing \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// "PACK" <version> <count>\x2C then one entry per object. Entries may be\n// ofs-delta / ref-delta compressed. Returns [{ sha\x2C type\x2C data }].\n// `lookup(sha)` resolves ref-delta bases that are not in this pack\n// (thin packs / objects in loose storage).\n\n// RFC 1950 adler32\x2C used to locate a stream's exact end when the\n// inflater (pako) does not verify the trailer itself.\nfunction adler32(bytes) {\n  let a = 1\x2C b = 0;\n  for (let i = 0; i < bytes.length; i++) {\n    a += bytes[i];\n    b += a;\n    if ((i & 0x3fff) === 0x3fff) { a %= 65521; b %= 65521; }\n  }\n  a %= 65521; b %= 65521;\n  return ((b << 16) | a) >>> 0;\n}\n\nfunction readUInt32BE(buf\x2C off) {\n  return ((buf[off] << 24) | (buf[off + 1] << 16) | (buf[off + 2] << 8) | buf[off + 3]) >>> 0;\n}\n\nasync function parsePack(pack\x2C lookup) {\n  if (dec.decode(pack.subarray(0\x2C 4)) !== "PACK") throw new Error("bad pack magic");\n  const dv = new DataView(pack.buffer\x2C pack.byteOffset\x2C pack.byteLength);\n  const version = dv.getUint32(4\x2C false);\n  if (version !== 2 && version !== 3) throw new Error("unsupported pack version " + version);\n  const count = dv.getUint32(8\x2C false);\n\n  // Pass 1: entry headers + compressed extents (find each zlib stream's end)\n  const entries = [];\n  let off = 12;\n  for (let n = 0; n < count; n++) {\n    const entryOff = off;\n    let c = pack[off++];\n    const type = (c >> 4) & 7;\n    let size = c & 0x0f;\n    let shift = 4;\n    while (c & 0x80) {\n      c = pack[off++];\n      size |= (c & 0x7f) << shift;\n      shift += 7;\n    }\n    let baseOff = null\x2C baseSha = null;\n    if (type === 6) {                    // ofs-delta\n      c = pack[off++];\n      let ofs = c & 0x7f;\n      while (c & 0x80) {\n        c = pack[off++];\n        ofs = ((ofs + 1) << 7) | (c & 0x7f);\n      }\n      baseOff = entryOff - ofs;\n    } else if (type === 7) {             // ref-delta\n      baseSha = hex(pack.subarray(off\x2C off + 20));\n      off += 20;\n    }\n    const compStart = off;\n    const compEnd = await findCompressedEnd(pack\x2C compStart\x2C size);\n    entries.push({ off: entryOff\x2C type\x2C size\x2C compStart\x2C compEnd\x2C baseOff\x2C baseSha });\n    off = compEnd;\n  }\n\n  // Pass 2: inflate + resolve deltas. ofs-delta bases are always earlier\n  // in the pack; ref-delta bases may appear later\x2C so loop until stable.\n  // Every resolved entry is immediately indexed by its computed sha\x2C so\n  // ref-delta bases that live in this pack resolve without any lookup.\n  const byOff = new Map(entries.map(e => [e.off\x2C e]));\n  const bySha = new Map();               // sha \u2192 { type\x2C data } (this pack)\n  const state = entries.map(() => null); // per-entry resolution\n  let changed = true;\n  while (changed) {\n    changed = false;\n    for (let n = 0; n < entries.length; n++) {\n      if (state[n]) continue;\n      const e = entries[n];\n      let base = null;\n      if (e.type === 6) {\n        const baseEntry = byOff.get(e.baseOff);\n        base = baseEntry ? state[entries.indexOf(baseEntry)] : null;\n        if (!base) throw new Error("pack: ofs-delta base unresolved");\n      } else if (e.type === 7) {\n        base = bySha.get(e.baseSha);     // may resolve in a later pass\n      }\n      if (e.type === 6 || e.type === 7) {\n        if (!base) continue;             // ref-delta base not seen yet\n        const delta = await inflate(pack.subarray(e.compStart\x2C e.compEnd));\n        state[n] = { type: base.type\x2C data: applyDelta(base.data\x2C delta) };\n        bySha.set(await objectSha(state[n])\x2C state[n]);\n        changed = true;\n      } else {\n        const data = await inflate(pack.subarray(e.compStart\x2C e.compEnd));\n        state[n] = { type: TYPE_NAME[e.type]\x2C data };\n        bySha.set(await objectSha(state[n])\x2C state[n]);\n        changed = true;\n      }\n    }\n  }\n\n  // Ref-delta bases that are not in this pack (thin packs\x2C or objects in\n  // loose storage / other packs) are resolved via `lookup`\x2C once per sha.\n  const missing = entries.filter((e\x2C n) => !state[n]);\n  if (missing.length && lookup) {\n    const fetched = new Map();           // baseSha \u2192 { type\x2C data } | null\n    for (let n = 0; n < entries.length; n++) {\n      if (state[n] || entries[n].type !== 7) continue;\n      const e = entries[n];\n      if (!fetched.has(e.baseSha)) {\n        let base = null;\n        try { base = await lookup(e.baseSha); } catch { base = null; }\n        fetched.set(e.baseSha\x2C base);\n      }\n      const base = fetched.get(e.baseSha);\n      if (base) {\n        const delta = await inflate(pack.subarray(e.compStart\x2C e.compEnd));\n        state[n] = { type: base.type\x2C data: applyDelta(base.data\x2C delta) };\n        bySha.set(await objectSha(state[n])\x2C state[n]);\n      }\n    }\n  }\n\n  // Pass 3: collect everything resolved.\n  const out = [];\n  for (let n = 0; n < entries.length; n++) {\n    if (!state[n]) throw new Error("pack: unresolved ref-delta base " + entries[n].baseSha);\n    const { type\x2C data } = state[n];\n    const header = `${type} ${data.length}\\0`;\n    const sha = await sha1Hex(concatBytes([enc.encode(header)\x2C data]));\n    bySha.set(sha\x2C { type\x2C data });\n    out.push({ sha\x2C type\x2C data });\n  }\n  return out;\n}\n\n// sha1 of an object: "<type> <size>\\0<data>"\nasync function objectSha({ type\x2C data }) {\n  const header = `${type} ${data.length}\\0`;\n  return sha1Hex(concatBytes([enc.encode(header)\x2C data]));\n}\n\n// Find the end of the zlib stream starting at `start` (whose inflated\n// size is `expectedSize`) without knowing the compressed length ahead of\n// time. A complete stream inflates to exactly `expectedSize` bytes and\n// ends with its adler32 trailer\x2C so "inflates completely" is monotone in\n// the end offset: probe up\x2C then binary-search for the smallest end that\n// yields a full object. zlib throws on truncated input; pako silently\n// returns partial output and may skip the trailer\x2C so the completion\n// check is the length plus (for pako) the presence of the adler32.\nasync function findCompressedEnd(pack\x2C start\x2C expectedSize) {\n  if (start >= pack.length) throw new Error("pack: truncated entry");\n  detectInflate();\n  let adler = null;\n  const complete = async (end) => {\n    let out;\n    try {\n      out = await inflate(pack.subarray(start\x2C end));\n    } catch { return false; }\n    if (out.length !== expectedSize) return false;\n    if (_usesPako) {\n      if (adler === null) adler = adler32(out);\n      // pako may have stopped before the trailer: require the adler32 of\n      // the output to appear in the slice (it sits just past the data).\n      for (let p = end - 4; p >= start; p--) {\n        if (readUInt32BE(pack\x2C p) === adler) return true;\n      }\n      return false;\n    }\n    return true;\n  };\n  let lo = start + 1;\n  let hi = Math.min(pack.length\x2C start + Math.max(64\x2C Math.ceil(expectedSize / 2)));\n  for (;;) {\n    if (await complete(hi)) break;\n    const span = hi - start;\n    if (hi >= pack.length || span >= pack.length - start) {\n      throw new Error("pack: truncated zlib stream");\n    }\n    hi = Math.min(pack.length\x2C start + Math.ceil(span * 1.5));\n  }\n  while (lo < hi) {\n    const mid = (lo + hi) >> 1;\n    if (await complete(mid)) hi = mid;\n    else lo = mid + 1;\n  }\n  return lo;\n}\n\n// \u2500\u2500\u2500 Transports \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Smart HTTP: the standard git wire protocol over HTTP.\n\nclass SmartHttpTransport {\n  constructor(baseUrl\x2C proxy) {\n    this.baseUrl = baseUrl.replace(/\\/+$/\x2C "");\n    this.proxy = proxy || "";\n  }\n\n  _url(p) { return this.proxy + this.baseUrl + p; }\n\n  async advertisement() {\n    let resp;\n    try {\n      resp = await fetch(this._url("/info/refs?service=git-upload-pack")\x2C {\n        headers: { Accept: "application/x-git-upload-pack-advertisement\x2C */*" }\x2C\n      });\n    } catch { return null; }\n    if (!resp.ok) return null;\n    let buf;\n    try { buf = new Uint8Array(await resp.arrayBuffer()); } catch { return null; }\n\n    const refs = new Map();\n    let caps = new Set()\x2C symref = null\x2C head = null;\n    try {\n      for (const p of decodePktLines(buf)) {\n        if (!p.data) continue;\n        const text = dec.decode(p.data);\n        const m = /^([0-9a-f]{40}) ([^\\x00\\n ]+)(.*)/.exec(text);\n        if (!m) continue;\n        refs.set(m[2]\x2C m[1]);\n        if (m[2] === "HEAD") head = m[1];\n        if (m[3].startsWith("\\x00")) {\n          caps = new Set(m[3].slice(1).split(" "));\n          for (const cap of caps) {\n            if (cap.startsWith("symref=HEAD:")) symref = cap.slice("symref=HEAD:".length);\n          }\n        }\n      }\n    } catch { return null; }\n    if (refs.size === 0) return null;\n    if (!head && symref) head = refs.get(symref) || null;\n    return { refs\x2C caps\x2C symref\x2C head };\n  }\n\n  async uploadPack(wants\x2C { filter\x2C caps } = {}) {\n    let base = this.gitSuffix ? this.baseUrl + ".git" : this.baseUrl;\n    let resp = await this._post(base\x2C wants\x2C { filter\x2C caps });\n    // Some hosts (GitLab) 301/422 the plain URL and only serve the\n    // wire protocol from the ".git" endpoint.\n    if ((resp.status === 301 || resp.status === 302 || resp.status === 307 ||\n         resp.status === 308 || resp.status === 404 || resp.status === 422) && !this.gitSuffix) {\n      this.gitSuffix = true;\n      resp = await this._post(this.baseUrl + ".git"\x2C wants\x2C { filter\x2C caps });\n    }\n    if (!resp.ok) throw new Error(`git-upload-pack: HTTP ${resp.status}`);\n    return extractPack(new Uint8Array(await resp.arrayBuffer()));\n  }\n\n  async _post(base\x2C wants\x2C { filter\x2C caps }) {\n    return fetch(base + "/git-upload-pack"\x2C {\n      method: "POST"\x2C\n      headers: {\n        "Content-Type": "application/x-git-upload-pack-request"\x2C\n        "Accept": "application/x-git-upload-pack-result\x2C */*"\x2C\n      }\x2C\n      body: uploadPackRequest(wants\x2C { filter\x2C caps })\x2C\n    });\n  }\n}\n\n// Dumb HTTP: plain GETs against a (bare) repo on a static file server.\n\nclass DumbHttpTransport {\n  constructor(baseUrl\x2C proxy) {\n    this.baseUrl = baseUrl.replace(/\\/+$/\x2C "");\n    this.proxy = proxy || "";\n  }\n\n  _url(p) { return this.proxy + this.baseUrl + p; }\n\n  async advertisement() {\n    let resp;\n    try { resp = await fetch(this._url("/info/refs")); } catch { return null; }\n    if (!resp.ok) return null;\n    let text;\n    try { text = await resp.text(); } catch { return null; }\n    const refs = new Map();\n    for (const line of text.split("\\n")) {\n      const m = /^([0-9a-f]{40})\\t(\\S+)$/.exec(line);\n      if (m) refs.set(m[2]\x2C m[1]);\n    }\n    if (refs.size === 0) return null;\n    let head = refs.get("HEAD") || null;\n    if (!head) {\n      try {\n        const hresp = await fetch(this._url("/HEAD"));\n        if (hresp.ok) {\n          const h = (await hresp.text()).trim();\n          const m = /^ref: (.+)$/.exec(h);\n          head = m ? refs.get(m[1]) || null : (/^[0-9a-f]{40}$/.test(h) ? h : null);\n        }\n      } catch {}\n    }\n    return { refs\x2C caps: new Set()\x2C symref: null\x2C head };\n  }\n\n  async readLoose(sha) {\n    let resp;\n    try {\n      resp = await fetch(this._url(`/objects/${sha.slice(0\x2C 2)}/${sha.slice(2)}`));\n    } catch { return null; }\n    if (!resp.ok) return null;\n    return new Uint8Array(await resp.arrayBuffer());\n  }\n\n  async packNames() {\n    let resp;\n    try { resp = await fetch(this._url("/objects/info/packs")); } catch { return []; }\n    if (!resp.ok) return [];\n    const names = [];\n    for (const line of (await resp.text()).split("\\n")) {\n      const m = /^P (.+\\.pack)$/.exec(line);\n      if (m) names.push(m[1]);\n    }\n    return names;\n  }\n\n  async readPack(name) {\n    const resp = await fetch(this._url("/objects/pack/" + name));\n    if (!resp.ok) throw new Error("dumb http: pack not found: " + name);\n    return new Uint8Array(await resp.arrayBuffer());\n  }\n}\n\n// \u2500\u2500\u2500 GitRepo: object store for one repository \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nclass GitRepo {\n  constructor(baseUrl\x2C proxy) {\n    this.baseUrl = baseUrl;\n    this.proxy = proxy || "";\n    this.transport = null;\n    this.ad = null;\n    this.lazyObjects = false;   // server allows wanting arbitrary shas\n    this.branchFetched = false; // full-branch pack already downloaded\n    this.objects = new Map();   // sha \u2192 { type\x2C data }\n    this._loading = new Map();  // sha \u2192 in-flight promise\n    this._scannedPacks = new Set();  // pack names already parsed & cached\n  }\n\n  async advertise() {\n    if (this.ad) return this.ad;\n    const smart = new SmartHttpTransport(this.baseUrl\x2C this.proxy);\n    let ad = await smart.advertisement();\n    if (ad) {\n      this.transport = smart;\n    } else {\n      const dumb = new DumbHttpTransport(this.baseUrl\x2C this.proxy);\n      ad = await dumb.advertisement();\n      if (ad) this.transport = dumb;\n      else throw new Error(`not a git repository: ${this.baseUrl}`);\n    }\n    this.ad = ad;\n    this.lazyObjects = ad.caps.has("allow-tip-sha1-in-want");\n    return ad;\n  }\n\n  async headSha() {\n    const ad = await this.advertise();\n    if (!ad.head) throw new Error("ENOENT: repository has no HEAD");\n    return ad.head;\n  }\n\n  // Capabilities to ask for in a want line. allow-tip-sha1-in-want lets us\n  // want arbitrary object ids (trees/blobs) \u2014 the basis of per-object lazy\n  // fetching. It is only sent for per-object wants\x2C never for a full-branch\n  // fetch (a ref is always allowed\x2C and some servers mis-handle the cap).\n  _wantCaps() {\n    if (!this.lazyObjects) return [];\n    return ["allow-tip-sha1-in-want"];\n  }\n\n  peekObject(sha) {\n    return this.objects.get(sha) || null;\n  }\n\n  async readObject(sha) {\n    const hit = this.objects.get(sha);\n    if (hit) return hit;\n    if (this._loading.has(sha)) return this._loading.get(sha);\n    const p = this._fetchObject(sha).then(\n      (obj) => { this.objects.set(sha\x2C obj); this._loading.delete(sha); return obj; }\x2C\n      (err) => { this._loading.delete(sha); throw err; }\n    );\n    this._loading.set(sha\x2C p);\n    return p;\n  }\n\n  async _fetchObject(sha) {\n    // Servers that advertise allow-tip-sha1-in-want (GitHub does) let us\n    // want any object id \u2014 fetch trees/blobs one tiny pack at a time.\n    if (this.transport instanceof SmartHttpTransport && this.lazyObjects) {\n      try {\n        const pack = await this.transport.uploadPack([sha]\x2C { caps: this._wantCaps() });\n        const objs = await parsePack(pack\x2C (baseSha) => this.readObject(baseSha));\n        for (const o of objs) this.objects.set(o.sha\x2C o);\n        const want = this.objects.get(sha);\n        if (!want) throw new Error(`object not in pack: ${sha}`);\n        return want;\n      } catch (e) {\n        // Some servers (GitLab) advertise allow-tip-sha1-in-want but reject\n        // it anyway ("not our ref"); fall back to a full-branch fetch\x2C which\n        // needs no special capabilities and works on every server.\n        this.lazyObjects = false;\n      }\n    }\n    // Otherwise fetch the whole branch once (all reachable objects)\x2C which\n    // works on every server; subsequent reads hit the cache.\n    if (!this.branchFetched) {\n      const head = await this.headSha();\n      let pack;\n      if (this.transport instanceof SmartHttpTransport) {\n        pack = await this.transport.uploadPack([head]);\n      } else {\n        // Dumb HTTP: try loose object first (recent objects are loose)\x2C\n        // else pull every packfile.\n        const zlibData = await this.transport.readLoose(sha);\n        if (zlibData) {\n          const obj = await parseLooseObject(zlibData);\n          this.objects.set(sha\x2C obj);\n          return obj;\n        }\n        pack = null;\n      }\n      this.branchFetched = true;\n      if (pack) {\n        const objs = await parsePack(pack\x2C (baseSha) => this.readObject(baseSha));\n        for (const o of objs) this.objects.set(o.sha\x2C o);\n        const want = this.objects.get(sha);\n        if (want) return want;\n      }\n      // Dumb HTTP without a usable pack: scan packfiles for the object.\n      return this._scanPacks(sha);\n    }\n    // Branch already fetched but this object still missing (dumb HTTP):\n    // fall through to packfile scanning.\n    return this._scanPacks(sha);\n  }\n\n  // Dumb HTTP: look the object up in loose storage\x2C else parse every\n  // packfile (each pack parsed at most once; all its objects cached).\n  async _scanPacks(sha) {\n    const zlibData = await this.transport.readLoose(sha);\n    if (zlibData) {\n      const obj = await parseLooseObject(zlibData);\n      this.objects.set(sha\x2C obj);\n      return obj;\n    }\n    const names = await this.transport.packNames();\n    for (const name of names) {\n      if (this._scannedPacks.has(name)) continue;\n      this._scannedPacks.add(name);\n      const p = await this.transport.readPack(name);\n      const objs = await parsePack(p\x2C (baseSha) => this.readObject(baseSha));\n      for (const o of objs) this.objects.set(o.sha\x2C o);\n      if (this.objects.has(sha)) return this.objects.get(sha);\n    }\n    throw new Error(`object not found: ${sha}`);\n  }\n}\n\n// \u2500\u2500\u2500 GitFS: the filesystem backend \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport class GitFS {\n  constructor(options = {}) {\n    this.proxy = options.proxy || "";\n    this.repos = new Map();   // baseUrl \u2192 GitRepo\n    this.splits = new Map();  // "host/rest..." \u2192 { repo\x2C filePath } | { fail }\n    this.visited = new Set(); // paths the user has actually seen (for locate)\n  }\n\n  // Return visited paths as a flat list\x2C for locate\n  async listVisited() {\n    return [...this.visited].sort();\n  }\n\n  _parse(relative) {\n    const parts = relative.replace(/^\\//\x2C "").split("/").filter(Boolean);\n    if (parts.length === 0) return { root: true };\n    if (parts.length === 1 && parts[0].includes(".")) return { file: parts[0] };\n    if (parts.length === 1) return { host: parts[0] };\n    return { host: parts[0]\x2C rest: parts.slice(1) };\n  }\n\n  _baseUrl(host\x2C repoPath) {\n    const scheme = /^localhost|^127\\.|^192\\.168\\.|^10\\.|^0\\.0\\.0\\.0/.test(host) ? "http" : "https";\n    return `${scheme}://${host}/${repoPath}`;\n  }\n\n  _repo(url) {\n    let r = this.repos.get(url);\n    if (!r) { r = new GitRepo(url\x2C this.proxy); this.repos.set(url\x2C r); }\n    return r;\n  }\n\n  // Find the longest repo path that advertises (handles GitLab subgroup\n  // paths)\x2C leaving the rest as the file path inside the repo.\n  async _resolve(host\x2C rest) {\n    const key = host + "/" + rest.join("/");\n    const hit = this.splits.get(key);\n    if (hit) {\n      if (hit.fail) throw new Error("ENOENT: no git repository at this path");\n      return hit;\n    }\n    for (let i = rest.length; i >= 1; i--) {\n      const repoPath = rest.slice(0\x2C i).join("/");\n      const filePath = rest.slice(i).join("/");\n      for (const candidate of [repoPath\x2C repoPath + ".git"]) {\n        const url = this._baseUrl(host\x2C candidate);\n        const repo = this._repo(url);\n        try {\n          await repo.advertise();\n          const result = { repo\x2C filePath };\n          this.splits.set(key\x2C result);\n          return result;\n        } catch {}\n      }\n    }\n    this.splits.set(key\x2C { fail: true });\n    throw new Error("ENOENT: no git repository at this path");\n  }\n\n  async _headTree(repo) {\n    const commitSha = await repo.headSha();\n    const commit = await repo.readObject(commitSha);\n    if (commit.type !== "commit") throw new Error("HEAD is not a commit");\n    const { tree } = parseCommit(commit.data);\n    if (!tree) throw new Error("commit has no tree");\n    return tree;\n  }\n\n  // Walk filePath ("a/b/c") down from treeSha; returns { sha\x2C mode }.\n  async _walk(repo\x2C treeSha\x2C filePath) {\n    let sha = treeSha;\n    let mode = 0o40000;\n    for (const part of filePath.split("/")) {\n      if (!part) continue;\n      const obj = await repo.readObject(sha);\n      if (obj.type !== "tree") throw new Error("ENOTDIR: " + part);\n      const entry = parseTree(obj.data).find(en => en.name === part);\n      if (!entry) throw new Error("ENOENT: " + part);\n      sha = entry.sha;\n      mode = entry.mode;\n    }\n    return { sha\x2C mode };\n  }\n\n  async _commitDate(repo) {\n    try {\n      const commitSha = await repo.headSha();\n      const commit = await repo.readObject(commitSha);\n      return parseCommit(commit.data).committerDate;\n    } catch { return undefined; }\n  }\n\n  // \u2500\u2500\u2500 Directory listing \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n  async list(path) {\n    const p = this._parse(path);\n\n    if (p.root || p.file) return this._rootListing(p);\n    if (p.host && !p.rest) return this._hostListing(p.host);\n\n    const { repo\x2C filePath } = await this._resolve(p.host\x2C p.rest);\n    const full = p.rest.join("/");\n    this.visited.add(`/${p.host}/${full}/`);\n\n    const tree = await this._headTree(repo);\n    const entry = filePath\n      ? await this._walk(repo\x2C tree\x2C filePath)\n      : { sha: tree\x2C mode: 0o40000 };\n    const obj = await repo.readObject(entry.sha);\n    if (obj.type !== "tree") throw new Error("EISDIR: not a directory");\n\n    const entries = parseTree(obj.data);\n    for (const e of entries) {\n      this.visited.add(`/${p.host}/${full}/${e.name}` + (e.mode === 0o40000 ? "/" : ""));\n    }\n    return entries\n      .map(e => (e.mode === 0o40000 ? e.name + "/" : e.name))\n      .sort();\n  }\n\n  // \u2500\u2500\u2500 File reading \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n  async _blobEntry(path) {\n    const p = this._parse(path);\n    if (p.file === "README.md" || p.file === ".readme") {\n      return { readme: true };\n    }\n    if (!p.rest || !p.rest.length) throw new Error("EISDIR: not a file");\n    const { repo\x2C filePath } = await this._resolve(p.host\x2C p.rest);\n    if (!filePath) throw new Error("EISDIR: not a file");\n    const tree = await this._headTree(repo);\n    const entry = await this._walk(repo\x2C tree\x2C filePath);\n    const obj = await repo.readObject(entry.sha);\n    if (obj.type === "tree") throw new Error("EISDIR: not a file");\n    this.visited.add(`/${p.host}/${p.rest.join("/")}`);\n    return { repo\x2C entry\x2C obj };\n  }\n\n  async read(path) {\n    const b = await this._blobEntry(path);\n    if (b.readme) return this._readme();\n    if (b.entry.mode === 0o160000) return b.entry.sha + "\\n";  // submodule pointer\n    return dec.decode(b.obj.data);\n  }\n\n  async readBlob(path) {\n    const b = await this._blobEntry(path);\n    if (b.readme) return new Blob([this._readme()]\x2C { type: "text/plain" });\n    return new Blob([b.obj.data]\x2C { type: "application/octet-stream" });\n  }\n\n  // \u2500\u2500\u2500 stat \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n  async stat(path) {\n    const p = this._parse(path);\n    if (p.root || p.file || (p.host && !p.rest)) {\n      return { type: "dir"\x2C size: 0\x2C mtime: undefined };\n    }\n    const { repo\x2C filePath } = await this._resolve(p.host\x2C p.rest);\n    const tree = await this._headTree(repo);\n    const mtime = await this._commitDate(repo);\n    const entry = filePath\n      ? await this._walk(repo\x2C tree\x2C filePath)\n      : { sha: tree\x2C mode: 0o40000 };\n    if (entry.mode === 0o40000) return { type: "dir"\x2C size: 0\x2C mtime };\n    // Don't fetch the blob just to learn its size \u2014 report it if cached.\n    const cached = repo.peekObject(entry.sha);\n    return { type: "file"\x2C size: cached ? cached.data.length : undefined\x2C mtime\x2C mode: entry.mode };\n  }\n\n  async write(path\x2C content) {\n    throw new Error("EROFS: git repos are read-only (use git push)");\n  }\n\n  async remove(path) {\n    throw new Error("EROFS: git repos are read-only");\n  }\n\n  // \u2500\u2500\u2500 Root / host listings and README \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n  _rootListing(p) {\n    const hosts = [...new Set(FEATURED.map(f => f.host))].sort();\n    return [...hosts.map(h => h + "/")\x2C "..."\x2C "README.md"];\n  }\n\n  _hostListing(host) {\n    const repos = FEATURED.filter(f => f.host === host).map(f => f.path + "/");\n    return [...repos\x2C "..."\x2C "README.md"];\n  }\n\n  async _readme() {\n    let text = `Git Filesystem\n===============\n\nMount any git repository as a filesystem \u2014 real git\x2C no API. This backend\nreads the git wire protocol directly: commits\x2C trees\x2C blobs\x2C and packfiles\n(ofs-delta / ref-delta included).\n\nUsage:\n  ls /mount/git/github.com/gmatht/sh2perl/\n  ls /mount/git/github.com/gmatht/sh2perl/src/fs/\n  cat /mount/git/github.com/gmatht/sh2perl/README.md\n  ls /mount/git/gitlab.com/group/subgroup/repo/\n\nAny public repo works:  /mount/git/{host}/{repo-path}/{file-path}\nGitLab subgroup paths are handled automatically.\n\nImplementation notes:\n  - Smart HTTP (git-upload-pack) by default; falls back to dumb HTTP for\n    static file servers serving a bare repo (local testing).\n  - Objects are fetched lazily \u2014 one small request per object. A directory\n    listing downloads only the trees it needs\x2C never the file contents.\n  - In the browser\x2C git hosts don't send CORS headers\x2C so the mount needs a\n    CORS proxy: new GitFS({ proxy: "https://cors.example/" }). The Node CLI\n    works directly against GitHub etc.\n\nFeatured repos:\\n`;\n    for (const f of FEATURED) {\n      text += `  ${f.host}/${f.path}  \u2014 ${f.desc}\\n`;\n    }\n    return text;\n  }\n\n  // Resolve a virtual path to the underlying repo's base URL (for\n  // `browse`)\x2C or null if it doesn't point into a repository.\n  async browseUrl(path) {\n    const p = this._parse(path);\n    if (!p.host || !p.rest || !p.rest.length) return null;\n    try {\n      const { repo } = await this._resolve(p.host\x2C p.rest);\n      return repo.baseUrl;\n    } catch { return null; }\n  }\n}\n
