script-source,120,file:///root/src/sh2runtime/src/fs/docsfs.js,// \u2500\u2500\u2500 DocsFS: the repo's own docs/ mounted as a filesystem \u2500\u2500\u2500\u2500\u2500\u2500\n//\n//   cat /docs/security.md \xb7 ls /docs \xb7 cat /docs/README.md\n//\n// Lets the shell read its own documentation. Browser: fetched from the\n// static server (../docs/ relative to the page\x2C so it works from a\n// GitHub Pages subdirectory too). Node CLI: read from disk (../docs/).\n// Read-only \u2014 OverlayFS wraps it so writes warn like other read-only\n// mounts.\n// -----------------------------------------------------------------\n\nexport class DocsFS {\n  constructor() {\n    this.files = ["README.md"\x2C "debashcl-integration.md"\x2C "security.md"\x2C "licences.md"];\n    this._loader = null;\n  }\n\n  _rel(path) {\n    return path.replace(/^\\/+|\\/+$/g\x2C "") || "";\n  }\n\n  // README.md lives at the repo root\x2C not in docs/.\n  _sourcePath(name) {\n    return name === "README.md" ? "../README.md" : "../docs/" + name;\n  }\n  _diskPath(name) {\n    return name === "README.md" ? "../../README.md" : "../../docs/" + name;\n  }\n\n  // The file loader: browser fetch / Node readFile (resolved lazily so\n  // neither environment needs the other's APIs).\n  _source() {\n    if (this._loader) return this._loader;\n    if (typeof document !== "undefined") {\n      this._loader = async (name) => {\n        const resp = await fetch(this._sourcePath(name));\n        if (!resp.ok) throw new Error("ENOENT: " + name);\n        return resp.text();\n      };\n    } else {\n      this._loader = async (name) => {\n        const { readFile } = await import("node:fs/promises");\n        return readFile(new URL(this._diskPath(name)\x2C import.meta.url)\x2C "utf8");\n      };\n    }\n    return this._loader;\n  }\n\n  async list(path) {\n    const rel = this._rel(path);\n    if (rel) throw new Error("ENOTDIR: " + path);\n    return this.files.slice();\n  }\n\n  async read(path) {\n    const name = this._rel(path);\n    if (!this.files.includes(name)) throw new Error("ENOENT: " + path);\n    return await (await this._source())(name);\n  }\n\n  async readBlob(path) {\n    const text = await this.read(path);\n    return new Blob([text]\x2C { type: "text/plain" });\n  }\n\n  async stat(path) {\n    const name = this._rel(path);\n    if (!name) return { type: "dir"\x2C size: 0\x2C mtime: undefined };\n    if (!this.files.includes(name)) throw new Error("ENOENT: " + path);\n    return { type: "file"\x2C size: 0\x2C mtime: undefined };\n  }\n\n  statSync(path) {\n    const name = this._rel(path);\n    if (!name) return { type: "dir"\x2C size: 0\x2C mtime: undefined };\n    if (!this.files.includes(name)) throw new Error("ENOENT: " + path);\n    return { type: "file"\x2C size: 0\x2C mtime: undefined };\n  }\n}\n
