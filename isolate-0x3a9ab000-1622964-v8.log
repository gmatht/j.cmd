script-source,136,file:///root/src/sh2runtime/src/fs/zipfs.js,// \u2500\u2500\u2500 zipfs.js \u2014 read-only VFS backend over a ZIP archive \u2500\u2500\u2500\u2500\u2500\u2500\u2500\n//\n// Lets users cd into .zip files: the VirtualFS lazily mounts any .zip\n// file at its own path\x2C wrapped in an OverlayFS (writes inside the\n// mounted dir land in the overlay\x2C never in the archive). This backend\n// serves list/stat/read/readBlob from the archive's central directory;\n// entry data is inflated with pako (browser) or node:zlib (CLI) \u2014 the\n// same wire format /bin/zip.js produces.\n//\n//   cd /home/backup.zip        \u2192 browse the archive like a directory\n//   ls /home/backup.zip/docs/\n//   cat /home/backup.zip/readme.txt\n//   cp /home/backup.zip/notes.txt /home/   (extract one file)\n//   cp /home/backup.zip /pc/               (the raw archive still copies)\n// -----------------------------------------------------------------\nimport { ensurePako } from "../pako.js";\n\nconst LOCAL_SIG = 0x04034b50;\nconst CENTRAL_SIG = 0x02014b50;\nconst EOCD_SIG = 0x06054b50;\n\nfunction rdU32(u8\x2C off) { return (u8[off] | (u8[off + 1] << 8) | (u8[off + 2] << 16) | (u8[off + 3] << 24)) >>> 0; }\nfunction rdU16(u8\x2C off) { return (u8[off] | (u8[off + 1] << 8)) & 0xffff; }\n\nfunction findEocd(bytes) {\n  const min = bytes.length >= 22 ? bytes.length - 22 : 0;\n  for (let i = bytes.length - 22; i >= min; i--) {\n    if (rdU32(bytes\x2C i) === EOCD_SIG) return i;\n  }\n  return null;\n}\n\n// DOS date/time \u2192 epoch ms (undefined when the zip has no timestamp).\nfunction dosToMs(dt\x2C dd) {\n  if (dd === 0) return undefined;\n  return new Date(\n    1980 + ((dd >> 9) & 0x7f)\x2C ((dd >> 5) & 0x0f) - 1\x2C dd & 0x1f\x2C\n    (dt >> 11) & 0x1f\x2C (dt >> 5) & 0x3f\x2C (dt & 0x1f) * 2\n  ).getTime();\n}\n\nexport class ZipFS {\n  constructor(bytes) {\n    this.bytes = bytes;\n    this._parsed = false;\n    this._dirs = new Set([""]);     // normalized dir paths ("" = root)\n    this._files = new Map();        // normalized file path \u2192 entry\n    this._children = new Map();     // dir path \u2192 sorted [names\u2026] ("dir/" suffixed)\n    this._inflate = null;\n  }\n\n  // Parse the central directory (throws "not a zip archive" on junk).\n  _parse() {\n    if (this._parsed) return;\n    const bytes = this.bytes;\n    const eocd = findEocd(bytes);\n    if (eocd === null) throw new Error("not a zip archive");\n    const count = rdU16(bytes\x2C eocd + 10);\n    const cdOff = rdU32(bytes\x2C eocd + 16);\n    const dec = new TextDecoder();\n    const files = new Map();\n    const dirs = new Set([""]);\n    let pos = cdOff;\n    for (let i = 0; i < count; i++) {\n      if (rdU32(bytes\x2C pos) !== CENTRAL_SIG) break;\n      const method = rdU16(bytes\x2C pos + 10);\n      const compSize = rdU32(bytes\x2C pos + 20);\n      const uncompSize = rdU32(bytes\x2C pos + 24);\n      const nameLen = rdU16(bytes\x2C pos + 28);\n      const localOff = rdU32(bytes\x2C pos + 42);\n      const dt = rdU16(bytes\x2C pos + 12);\n      const dd = rdU16(bytes\x2C pos + 14);\n      const name = dec.decode(bytes.subarray(pos + 46\x2C pos + 46 + nameLen))\n        .replace(/\\\\/g\x2C "/");      // Windows zips use backslash separators\n      pos += 46 + nameLen + rdU16(bytes\x2C pos + 30) + rdU16(bytes\x2C pos + 32);\n      // Normalize: drop "." components and empty parts (zips made with\n      // `zip x .` carry "./"-prefixed names) while keeping the dir marker.\n      const norm = name.split("/").filter((c) => c && c !== ".").join("/");\n      if (name.endsWith("/")) {\n        dirs.add(norm || "");\n      } else {\n        files.set(norm\x2C { method\x2C compSize\x2C uncompSize\x2C localOff\x2C mtime: dosToMs(dt\x2C dd) });\n      }\n    }\n    // Implicit parent directories (a zip may list "a/b/c.txt" with no\n    // "a/" or "a/b/" entries).\n    for (const p of files.keys()) {\n      let d = p;\n      while (d.includes("/")) {\n        d = d.slice(0\x2C d.lastIndexOf("/"));\n        dirs.add(d);\n      }\n    }\n    // Direct children of each directory.\n    const children = new Map();\n    const addChild = (dir\x2C name) => {\n      let arr = children.get(dir);\n      if (!arr) { arr = []; children.set(dir\x2C arr); }\n      if (!arr.includes(name)) arr.push(name);\n    };\n    for (const f of files.keys()) {\n      const i = f.lastIndexOf("/");\n      addChild(i === -1 ? "" : f.slice(0\x2C i)\x2C f.slice(i + 1));\n    }\n    for (const d of dirs) {\n      if (d === "") continue;\n      const i = d.lastIndexOf("/");\n      addChild(i === -1 ? "" : d.slice(0\x2C i)\x2C d.slice(i + 1) + "/");\n    }\n    for (const arr of children.values()) arr.sort();\n    this._files = files;\n    this._dirs = dirs;\n    this._children = children;\n    this._parsed = true;\n  }\n\n  _norm(path) {\n    const p = String(path == null ? "" : path).replace(/\\\\/g\x2C "/").replace(/^\\/+|\\/+$/g\x2C "");\n    return p;   // "" is the archive root\n  }\n\n  async list(path) {\n    this._parse();\n    const norm = this._norm(path);\n    if (this._files.has(norm)) throw new Error("ENOTDIR: Not a directory");\n    return (this._children.get(norm) || []).slice();\n  }\n\n  async stat(path) {\n    this._parse();\n    const norm = this._norm(path);\n    if (this._dirs.has(norm)) return { type: "dir"\x2C size: 0\x2C mtime: undefined };\n    const f = this._files.get(norm);\n    if (!f) throw new Error("ENOENT");\n    return { type: "file"\x2C size: f.uncompSize\x2C mtime: f.mtime };\n  }\n\n  statSync(path) {\n    try { this._parse(); } catch { return null; }\n    const norm = this._norm(path);\n    if (this._dirs.has(norm)) return { type: "dir"\x2C size: 0\x2C mtime: undefined };\n    const f = this._files.get(norm);\n    if (!f) return null;\n    return { type: "file"\x2C size: f.uncompSize\x2C mtime: f.mtime };\n  }\n\n  async read(path) {\n    const data = await this._readEntry(path);\n    return new TextDecoder().decode(data);\n  }\n\n  async readBlob(path) {\n    const data = await this._readEntry(path);\n    return new Blob([data]);\n  }\n\n  async _readEntry(path) {\n    this._parse();\n    const norm = this._norm(path);\n    if (this._dirs.has(norm)) throw new Error("EISDIR: Is a directory");\n    const f = this._files.get(norm);\n    if (!f) throw new Error("ENOENT");\n    const bytes = this.bytes;\n    const dataOff = f.localOff + 30 + rdU16(bytes\x2C f.localOff + 26) + rdU16(bytes\x2C f.localOff + 28);\n    const comp = bytes.subarray(dataOff\x2C dataOff + f.compSize);\n    if (f.method === 0) return comp;                       // stored\n    if (f.method === 8) return (await this._inflater())(comp);  // deflate\n    throw new Error(`zip: unsupported compression method ${f.method}`);\n  }\n\n  // pako in the browser\x2C node:zlib in the CLI (same engine /bin/zip.js uses).\n  async _inflater() {\n    if (this._inflate) return this._inflate;\n    if (typeof window !== "undefined") {\n      await ensurePako();  // lazy-load vendor/pako.min.js on first zip browse\n      if (window.pako && window.pako.inflateRaw) {\n        this._inflate = (u8) => new Uint8Array(window.pako.inflateRaw(u8));\n        return this._inflate;\n      }\n    }\n    const nz = await import("node:zlib");\n    this._inflate = (u8) => new Uint8Array(nz.inflateRawSync(u8));\n    return this._inflate;\n  }\n\n  async write() { throw new Error("EROFS: zip archives are read-only (cp files out to extract)"); }\n  async writeBlob() { throw new Error("EROFS: zip archives are read-only (cp files out to extract)"); }\n  async remove() { throw new Error("EROFS: zip archives are read-only"); }\n}\n
