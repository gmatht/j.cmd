script-source,125,file:///root/src/sh2runtime/src/fs/httpfs.js,// \u2500\u2500\u2500 HttpFS: Fetch remote URLs as files \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Only works for CORS-enabled origins:\n//   api.github.com\x2C registry.npmjs.org\x2C pypi.org\x2C raw.githubusercontent.com\n//   pokeapi.co\x2C api.chess.com\x2C api.weather.gov\x2C cdn.jsdelivr.net\n//\n// The known sample files form a directory TREE\x2C so the mount browses\n// like a filesystem: hosts are folders (ls /http/\x2C cd upload.wikimedia.org/)\x2C\n// and the curated files sit at the leaves. cat/stat on a known folder\n// says EISDIR instead of fetching (or failing on) the host's homepage:\n//   ls /http/                            README.md\x2C archive.org/\x2C mdn.github.io/\x2C \u2026\n//   ls /http/upload.wikimedia.org/       wikipedia/\n//   cat /http/upload.wikimedia.org/wikipedia/commons/6/6a/JavaScript-logo.png\n// Any OTHER path is the open URL space \u2014 the path IS the URL\x2C fetched\n// straight (no listing\x2C no tree): cat /http/example.com/data.json\n//\n// Each featured file is verified to send Access-Control-Allow-Origin: *:\n//   archive.org (mp3 only \u2014 small files land on the CORS-enabled\n//     ia*.us.archive.org nodes; large video streams go to the\n//     dn*.ca.archive.org nodes\x2C which DON'T send CORS)\x2C\n//   raw.githubusercontent.com\x2C cdn.jsdelivr.net\x2C\n//   upload.wikimedia.org\x2C mdn.github.io (GitHub Pages)\x2C picsum.photos\n\nimport { RamFS } from "./ramfs.js";\n\n// Featured sample files\x2C one per common mime type. The path form is\n// the URL itself\x2C so `cat /http/<path>` fetches https://<path> with no\n// rewriting \u2014 copy-paste straight from the listing. Verified CORS:\n// each of these serves Access-Control-Allow-Origin: * and (for the\n// archives) supports Range requests.\nconst FEATURED = [\n  { path: "archive.org/download/testmp3testfile/mpthreetest.mp3"\x2C\n    desc: "mp3 \u2014 Internet Archive test file" }\x2C\n  { path: "raw.githubusercontent.com/mdn/webaudio-examples/main/audio-analyser/viper.mp3"\x2C\n    desc: "mp3 \u2014 MDN WebAudio example (GitHub raw)" }\x2C\n  { path: "upload.wikimedia.org/wikipedia/commons/d/db/Alligatorbellowedit.ogg"\x2C\n    desc: "ogg \u2014 Wikimedia Commons alligator bellow" }\x2C\n  { path: "upload.wikimedia.org/wikipedia/commons/6/6a/JavaScript-logo.png"\x2C\n    desc: "png \u2014 Wikimedia Commons image" }\x2C\n  { path: "picsum.photos/id/237/200/300"\x2C\n    desc: "jpg \u2014 picsum.photos placeholder" }\x2C\n  { path: "upload.wikimedia.org/wikipedia/commons/c/c1/Diehl_Wecker_%28ca._1955%29.webm"\x2C\n    desc: "webm \u2014 1955 clock film\x2C VP9 1080p (Wikimedia Commons\x2C 12 MB)" }\x2C\n  { path: "mdn.github.io/learning-area/html/multimedia-and-embedding/video-and-audio-content/rabbit320.mp4"\x2C\n    desc: "mp4 \u2014 MDN learning area (GitHub Pages)" }\x2C\n  { path: "raw.githubusercontent.com/git/git/master/README.md"\x2C\n    desc: "txt \u2014 git repo README (GitHub raw)" }\x2C\n  { path: "raw.githubusercontent.com/Stuk/jszip/main/test/ref/all.zip"\x2C\n    desc: "zip \u2014 small test archive (jszip); cd into it to browse" }\x2C\n];\n\nconst README_PATH = "README.md";\n\n// A featured path is a known file; every prefix of one is a directory\n// in the /http tree. cat/stat on a known dir \u2192 EISDIR.\nfunction isKnownDir(rel) {\n  if (rel === "") return true; // the mount root is a directory\n  return FEATURED.some(f => f.path.startsWith(rel + "/"));\n}\n\nexport class HttpFS {\n  constructor() {\n    this.cache = new RamFS();\n  }\n\n  _url(path) {\n    let url = path.replace(/^\\//\x2C "");\n    if (!url.startsWith("http://") && !url.startsWith("https://")) {\n      url = "https://" + url;\n    }\n    return url;\n  }\n\n  // Children of `path` in the known-file tree: directories end with "/".\n  // The root lists the hosts; unknown paths list nothing (the URL space\n  // can't be enumerated \u2014 cat/curl still reach them).\n  async list(path) {\n    const rel = (path || "/").replace(/^\\/+/\x2C "").replace(/\\/+$/\x2C "");\n    const children = new Set();\n    if (rel === "") children.add(README_PATH);\n    for (const f of FEATURED) {\n      if (rel === "") {\n        children.add(f.path.split("/")[0] + "/");\n      } else if (f.path.startsWith(rel + "/")) {\n        const rest = f.path.slice(rel.length + 1);\n        children.add(rest.includes("/") ? rest.split("/")[0] + "/" : rest);\n      }\n    }\n    return [...children].sort();\n  }\n\n  // Known dirs and known files are typed; anything else is unknown\n  // without fetching (keeps `ls` from downloading samples to size them).\n  async stat(path) {\n    const rel = path.replace(/^\\/+/\x2C "").replace(/\\/+$/\x2C "");\n    if (rel === README_PATH) return { type: "file"\x2C size: 0\x2C mtime: undefined };\n    if (isKnownDir(rel)) return { type: "dir"\x2C size: 0\x2C mtime: undefined };\n    for (const f of FEATURED) {\n      if (f.path === rel) return { type: "file"\x2C size: 0\x2C mtime: undefined };\n    }\n    return null;\n  }\n\n  async read(path) {\n    const rel = path.replace(/^\\/+/\x2C "");\n    if (rel === README_PATH) return this._readme();\n    if (isKnownDir(rel)) throw new Error("EISDIR: Is a directory");\n\n    try {\n      return await this.cache.read(path);\n    } catch {}\n\n    const url = this._url(path);\n    const resp = await fetch(url);\n    if (!resp.ok) throw new Error(`HTTP ${resp.status}: ${url}`);\n    const text = await resp.text();\n    await this.cache.write(path\x2C text);\n    return text;\n  }\n\n  async readBlob(path) {\n    const rel = path.replace(/^\\/+/\x2C "");\n    if (rel === README_PATH) return new Blob([this._readme()]\x2C { type: "text/plain" });\n    if (isKnownDir(rel)) throw new Error("EISDIR: Is a directory");\n\n    const url = this._url(path);\n    const resp = await fetch(url);\n    if (!resp.ok) throw new Error(`HTTP ${resp.status}: ${url}`);\n    const blob = await resp.blob();\n    // Also cache text version for read()\n    try {\n      const text = await blob.text();\n      await this.cache.write(path\x2C text);\n    } catch {}\n    return blob;\n  }\n\n  async write(path\x2C content) {\n    // Writing to HTTP would require PUT/POST \u2014 not implemented\n    throw new Error("EROFS: Read-only filesystem (HTTP)");\n  }\n\n  async remove(path) {\n    await this.cache.remove(path);\n  }\n\n  _readme() {\n    let text = `HTTP Filesystem\n===============\n\nMount point for fetching any CORS-enabled URL as a file. The known\nsample files form a folder tree \u2014 hosts are directories:\n\n  ls /http/\n  cd upload.wikimedia.org/\n  cat upload.wikimedia.org/wikipedia/commons/6/6a/JavaScript-logo.png\n\nFeatured sample files (CORS verified \u2014 one per file type):\n`;\n    for (const f of FEATURED) {\n      text += `  ${f.path}\\n      ${f.desc}\\n`;\n    }\n    text += `\\nAny other CORS-enabled URL is fair game: the path IS the URL\x2C\nso cat/curl reach the whole web (ls lists only the known tree).\nThe browser enforces CORS \u2014 only origins that send\nAccess-Control-Allow-Origin respond. This mount is read-only; writes\nland in a local overlay instead.\\n`;\n    return text;\n  }\n}\n
