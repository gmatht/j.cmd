+/* find the first top-level `&&` (outside quotes / $() depth) */
+static char *
+web_find_ampamp (const char *s)
+{
+  int in_s = 0, in_d = 0, depth = 0;
+  for (const char *p = s; *p; p++)
+    {
+      if (in_s) { if (*p == '\'') in_s = 0; continue; }
+      if (in_d) { if (*p == '"') in_d = 0; continue; }
+      if (*p == '\'') { in_s = 1; continue; }
+      if (*p == '"') { in_d = 1; continue; }
+      if (*p == '$' && p[1] == '(') { depth++; continue; }
+      if (*p == ')' && depth > 0) { depth--; continue; }
+      if (depth == 0 && *p == '&' && p[1] == '&')
+        return (char *)p;
+    }
+  return (char *)NULL;
+}
