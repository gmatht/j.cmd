+#if defined (BASH_WEB_SPAWN)
+/* ── virtual-process port: whole-pipeline host run ──────────────────
+   A pipeline (`a | b | c`) can't fork in bash.wasm, so instead of
+   forking per element we reconstruct the whole pipeline as a single
+   quoted command line and run it in the host shell (which has real
+   pipes). Words are single-quoted so the host re-tokenises them to the
+   same arguments; per-element redirects (< > >> <<<) are preserved. */
+
+static char *
+web_quote (const char *s)
+{
+  size_t len = STRLEN (s);
+  char *out = xmalloc (len * 2 + 3);
+  char *p = out;
+  *p++ = '\'';
+  for (const char *c = s; *c; c++)
+    {
+      if (*c == '\'')
+        {
+          *p++ = '\''; *p++ = '\\'; *p++ = '\''; *p++ = '\'';
+        }
+      else
+        *p++ = *c;
+    }
+  *p++ = '\'';
+  *p = '\0';
+  return out;
+}
+
+static void
+web_append (char **dst, const char *piece)
+{
+  size_t dl = *dst ? STRLEN (*dst) : 0;
+  size_t pl = STRLEN (piece);
+  *dst = xrealloc (*dst, dl + pl + 2);
+  if (dl)
+    (*dst)[dl++] = ' ';
+  memcpy (*dst + dl, piece, pl + 1);
+}
+
+static char *
+web_words_to_string (WORD_LIST *words)
+{
+  char *res = (char *)NULL;
+  for (WORD_LIST *wl = words; wl; wl = wl->next)
+    {
+      /* Pass the word through RAW — these are the parse-time tokens, not
+         the expanded argv, so the host shell re-parses the exact same
+         syntax (quotes, $VAR, backslash escapes). Extra quoting would
+         mangle things like `echo "b"` (quotes preserved in the token) or
+         `$HOME` (must stay expandable). */
+      web_append (&res, wl->word->word ? wl->word->word : "");
+    }
+  return res;
+}
+
+static char *
+web_redirects_to_string (REDIRECT *redirects)
+{
+  char *res = (char *)NULL;
+  for (REDIRECT *rd = redirects; rd; rd = rd->next)
+    {
+      const char *op = (char *)NULL;
+      switch (rd->instruction)
+        {
+        case r_input_direction: op = "<"; break;
+        case r_output_direction: op = ">"; break;
+        case r_appending_to: op = ">>"; break;
+        case r_reading_string: op = "<<<"; break;
+        default: continue;	/* heredocs, 2>, dup, close — not portable */
+        }
+      const char *target = rd->redirectee.filename ? rd->redirectee.filename->word : (char *)NULL;
+      if (target == 0)
+        continue;
+      char *q = web_quote (target);
+      web_append (&res, op);
+      web_append (&res, q);
+      free (q);
+    }
+  return res;
+}
+
+static char *
+web_pipeline_to_string (COMMAND *command)
+{
+  char *res = (char *)NULL;
+  int first = 1;
+  COMMAND *cmd = command;
+
+  while (cmd && cmd->type == cm_connection &&
+         cmd->value.Connection && cmd->value.Connection->connector == '|')
+    {
+      COMMAND *el = cmd->value.Connection->first;
+      if (el && el->type == cm_simple)
+        {
+          char *w = web_words_to_string (el->value.Simple->words);
+          char *r = web_redirects_to_string (el->value.Simple->redirects);
+          if (!first)
+            web_append (&res, "|");
+          if (w && *w)
+            web_append (&res, w);
+          if (r && *r)
+            web_append (&res, r);
+          free (w);
+          free (r);
+        }
+      else
+        {
+          free (res);
+          return (char *)NULL;	/* nested connections / groups — not portable */
+        }
+      first = 0;
+      cmd = cmd->value.Connection->second;
+    }
+
+  /* the rightmost element */
+  if (cmd && cmd->type == cm_simple)
+    {
+      char *w = web_words_to_string (cmd->value.Simple->words);
+      char *r = web_redirects_to_string (cmd->value.Simple->redirects);
+      if (!first)
+        web_append (&res, "|");
+      if (w && *w)
+        web_append (&res, w);
+      if (r && *r)
+        web_append (&res, r);
+      free (w);
+      free (r);
+    }
+  else
+    {
+      free (res);
+      return (char *)NULL;
+    }
+  return res;
+}
+#endif /* BASH_WEB_SPAWN */
